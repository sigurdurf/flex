<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Release builds (and any build using the main source set) require HTTPS
      so credentials and bearer tokens are never sent over cleartext HTTP.
      Debug builds override this config under src/debug/res/xml/ to allow
      cleartext LAN connections during development.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

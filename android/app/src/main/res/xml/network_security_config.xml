<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Flex servers are commonly run on a LAN over plain HTTP (e.g.
      http://192.168.0.10:8096). Cleartext is permitted so that direct LAN
      connections work out of the box. Tighten this for public deployments.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
